# Charging Stations Configuration - EXAMPLE
# Copy this file to .env and edit with your station codes
#
# EVC web application API key (required)
EVC_API_KEY=replace-with-your-api-key

# Format: QR_CODE:Display Name (comma-separated for multiple stations)
STATIONS=GRDR-0123*1:Station 1,GRDR-0124*1:Station 2

# Timezone
TZ=Europe/Amsterdam

# Server port (optional, default 5000)
# PORT=5000

# Refresh interval in seconds (optional, default 300)
# REFRESH_INTERVAL=300

# Python log level (optional, default INFO)
# LOG_LEVEL=INFO
